launch_profile() {
  local profile=$1
  shift || true

  local target_mode="ide"
  local forward_args=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --ide)
        target_mode="ide"
        ;;
      --chat | --app)
        target_mode="chat"
        ;;
      --all | --both | --duo)
        target_mode="all"
        ;;
      *)
        forward_args+=("$1")
        ;;
    esac
    shift
  done

  local profile_path
  profile_path="$(profile_dir "$profile")"
  if [ ! -d "$profile_path" ]; then
    abort "profile '$profile' does not exist. Run: multigravity new $profile"
  fi

  if is_auth_only "$profile"; then
    create_auth_only_layout "$profile_path"
  else
    create_profile_layout "$profile_path"
  fi

  # Auto-upgrade any legacy cloned shortcuts on macOS
  if [ "$(platform)" = "darwin" ]; then
    local ide_shortcut chat_shortcut
    ide_shortcut="$(mac_shortcut_path "$profile" "ide")"
    chat_shortcut="$(mac_shortcut_path "$profile" "chat")"
    if { [ -d "$ide_shortcut" ] && [ ! -f "$ide_shortcut/Contents/MacOS/run" ]; } || \
       { [ -d "$chat_shortcut" ] && [ ! -f "$chat_shortcut/Contents/MacOS/run" ]; }; then
      create_shortcuts "$profile"
    fi
  fi

  case "$target_mode" in
    ide)
      launch_ide_app "$profile" "${forward_args[@]+"${forward_args[@]}"}"
      ;;
    chat)
      launch_chat_app "$profile" "${forward_args[@]+"${forward_args[@]}"}"
      ;;
    all)
      launch_ide_app "$profile" "${forward_args[@]+"${forward_args[@]}"}"
      launch_chat_app "$profile" "${forward_args[@]+"${forward_args[@]}"}"
      ;;
  esac
}

list_profiles() {
  local entries=""
  local dir
  local raw=${1-}

  if [ "$raw" != "--raw" ]; then
    echo "Existing profiles:"
  fi

  if [ ! -d "$BASE" ]; then
    if [ "$raw" != "--raw" ]; then
      echo "(none)"
    fi
    return 0
  fi

  for dir in "$BASE"/*; do
    [ -d "$dir" ] || continue
    local name
    name="$(basename "$dir")"
    [ "$name" = ".templates" ] && continue
    entries="${entries}${name}"$'\n'
  done

  if [ -z "$entries" ]; then
    if [ "$raw" != "--raw" ]; then
      echo "(none)"
    fi
  else
    printf '%s' "$entries" | sort
  fi
}

new_profile() {
  local profile=""
  local auth_only=false
  local from_template=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --auth-only) auth_only=true ;;
      --from) from_template="${2-}"; shift ;;
      -*) abort "unknown option: $1" ;;
      *) profile="$1" ;;
    esac
    shift
  done

  validate_name "$profile"

  local profile_path
  profile_path="$(profile_dir "$profile")"
  if [ -d "$profile_path" ]; then
    abort "profile '$profile' already exists"
  fi

  mkdir -p "$BASE"

  if [ -n "$from_template" ]; then
    local tpl_path
    tpl_path="$(templates_dir)/$from_template"
    if [ ! -d "$tpl_path" ]; then
      abort "template '$from_template' does not exist. Run: multigravity template list"
    fi
    print_info "Creating profile '$profile' from template '$from_template'..."
    cp -R "$tpl_path" "$profile_path"
  elif [ "$auth_only" = true ]; then
    create_auth_only_layout "$profile_path"
  else
    create_profile_layout "$profile_path"
  fi

  print_info "Created profile '$profile' (IDE & Companion layout initialized)"
  create_shortcuts "$profile"
}

delete_profile() {
  local profile=$1
  local profile_path confirm

  validate_name "$profile"

  profile_path="$(profile_dir "$profile")"
  if [ ! -d "$profile_path" ]; then
    abort "profile '$profile' does not exist"
  fi

  read -r -p "Delete profile '$profile' and all its data? [y/N] " confirm
  if [[ "$confirm" =~ ^[Yy]$ ]]; then
    rm -rf "$profile_path"
    remove_shortcuts "$profile"
    print_info "Deleted profile '$profile'"
  else
    print_info "Aborted."
  fi
}

rename_profile() {
  local old=$1
  local new=$2
  local old_path new_path

  validate_name "$old"
  validate_name "$new"

  old_path="$(profile_dir "$old")"
  new_path="$(profile_dir "$new")"

  if [ ! -d "$old_path" ]; then
    abort "profile '$old' does not exist"
  fi
  if [ -d "$new_path" ]; then
    abort "profile '$new' already exists"
  fi

  mv "$old_path" "$new_path"
  remove_shortcuts "$old"
  create_shortcuts "$new"

  print_info "Renamed profile '$old' to '$new'"
}

clone_profile() {
  local src=$1
  local dest=$2
  local src_path dest_path

  validate_name "$src"
  validate_name "$dest"

  src_path="$(profile_dir "$src")"
  dest_path="$(profile_dir "$dest")"

  if [ ! -d "$src_path" ]; then
    abort "source profile '$src' does not exist"
  fi
  if [ -d "$dest_path" ]; then
    abort "destination profile '$dest' already exists"
  fi

  print_info "Cloning profile '$src' to '$dest'..."
  cp -R "$src_path" "$dest_path"
  create_shortcuts "$dest"

  print_info "Successfully cloned '$src' to '$dest'"
}

doctor_cli() {
  local errors=0
  local warnings=0
  local ide_found="" chat_found=""

  print_info "Checking Multigravity Duo environment..."

  # 1. Platform Check
  if platform &>/dev/null; then
    echo "  [✓] Platform: $(platform)"
  else
    echo "  [✗] Platform: Unknown"
    errors=$((errors + 1))
  fi

  # 2. Antigravity IDE Check
  if ide_found=$(find_ide_app); then
    echo "  [✓] Antigravity IDE: Found at $ide_found"
  else
    echo "  [!] Antigravity IDE: Not found in standard locations."
    warnings=$((warnings + 1))
  fi

  # 3. Antigravity Companion / Chat Check
  if chat_found=$(find_chat_app); then
    echo "  [✓] Antigravity (Chat): Found at $chat_found"
  else
    echo "  [!] Antigravity (Chat): Not found in standard locations."
    warnings=$((warnings + 1))
  fi

  if [ -z "$ide_found" ] && [ -z "$chat_found" ]; then
    echo "  [✗] Neither Antigravity IDE nor Antigravity app was detected."
    errors=$((errors + 1))
  fi

  # 4. Path Check
  local installed
  installed="$(command -v multigravity 2>/dev/null || true)"
  if [ -n "$installed" ]; then
    echo "  [✓] Global Binary: $installed"
  else
    echo "  [!] Global Binary: Not found in PATH. Run install script or update PATH."
    warnings=$((warnings + 1))
  fi

  # 5. Icon Check (macOS)
  if [ "$(platform)" = "darwin" ]; then
    local icon_path
    icon_path="$(dirname "$(script_path)")/icon.icns"
    if [ -f "$icon_path" ]; then
      echo "  [✓] Application Icon: Found"
    else
      echo "  [!] Application Icon: Missing ($icon_path)."
      warnings=$((warnings + 1))
    fi
  fi

  # 6. Base Directory
  if [ -d "$BASE" ]; then
    if [ -w "$BASE" ]; then
      echo "  [✓] Profile storage: $BASE (writable)"
    else
      echo "  [✗] Profile storage: $BASE (NOT writable)"
      errors=$((errors + 1))
    fi
  else
    echo "  [!] Profile storage: $BASE (Not yet created)"
  fi

  # 7. SSH Configuration (Remote SSH / VMs)
  if [ -d "$REAL_HOME/.ssh" ]; then
    local ssh_hosts=0
    if [ -f "$REAL_HOME/.ssh/config" ]; then
      ssh_hosts=$(grep -c -i "^Host " "$REAL_HOME/.ssh/config" 2>/dev/null || echo 0)
    fi
    echo "  [✓] SSH Environment: $REAL_HOME/.ssh ($ssh_hosts host(s) configured in ssh_config)"
  else
    echo "  [!] SSH Directory: $REAL_HOME/.ssh not found (SSH config will be created on demand)"
  fi

  # 8. Antigravity Skills & Plugins
  if [ -d "$REAL_HOME/.gemini/config/plugins" ]; then
    local plugin_count
    plugin_count=$(find "$REAL_HOME/.gemini/config/plugins" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
    echo "  [✓] Antigravity Skills & Plugins: $plugin_count plugin(s) found in $REAL_HOME/.gemini/config/plugins"
  fi

  echo ""
  if [ $errors -eq 0 ]; then
    if [ $warnings -eq 0 ]; then
      print_info "✓ Your Multigravity Duo environment looks perfect!"
    else
      print_info "Found $warnings warning(s). Multigravity Duo is operational."
    fi
  else
    print_info "✗ Found $errors error(s) and $warnings warning(s). Please review the findings above."
  fi
}

profile_stats() {
  if [ ! -d "$BASE" ]; then
    print_info "No profiles found."
    return 0
  fi

  print_info "Multigravity Duo Profile Storage Breakdown:"
  printf "%-18s %-10s %-12s %-12s %s\n" "PROFILE" "TOTAL" "IDE EXT" "CHAT EXT" "TYPE"
  printf "%-18s %-10s %-12s %-12s %s\n" "-------" "-----" "-------" "--------" "----"

  local dir
  for dir in "$BASE"/*; do
    [ -d "$dir" ] || continue
    local name
    name=$(basename "$dir")
    [ "$name" = ".templates" ] && continue

    local size
    size=$(du -sh "$dir" 2>/dev/null | cut -f1)

    local ide_dir chat_dir ide_ext_count=0 chat_ext_count=0
    ide_dir="$(ide_extensions_dir "$dir")"
    chat_dir="$(chat_extensions_dir "$dir")"

    if [ -d "$ide_dir" ]; then
      ide_ext_count=$(find "$ide_dir" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l | tr -d ' ')
    fi

    if [ -d "$chat_dir" ]; then
      chat_ext_count=$(find "$chat_dir" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l | tr -d ' ')
    fi

    local ptype="full"
    [ -f "$dir/.auth-only" ] && ptype="auth-only"

    printf "%-18s %-10s %-12s %-12s %s\n" "$name" "$size" "$ide_ext_count" "$chat_ext_count" "$ptype"
  done

  echo ""
  local total
  total=$(du -sh "$BASE" 2>/dev/null | cut -f1)
  print_info "Total usage: $total"
}

repair_profile() {
  local target=${1-}
  if [ -n "$target" ]; then
    local ppath
    ppath="$(profile_dir "$target")"
    [ -d "$ppath" ] || abort "profile '$target' does not exist"
    print_info "Repairing profile '$target' and updating shortcuts..."
    if is_auth_only "$target"; then
      create_auth_only_layout "$ppath"
    else
      create_profile_layout "$ppath"
    fi
    create_shortcuts "$target"
    print_info "✓ Profile '$target' repaired successfully."
  else
    print_info "Repairing and updating all existing profiles and shortcuts..."
    local count=0
    for dir in "$BASE"/*; do
      [ -d "$dir" ] || continue
      local name
      name=$(basename "$dir")
      [ "$name" = ".templates" ] && continue
      print_info "  → Syncing profile '$name'..."
      if is_auth_only "$name"; then
        create_auth_only_layout "$dir"
      else
        create_profile_layout "$dir"
      fi
      create_shortcuts "$name"
      count=$((count + 1))
    done
    print_info "✓ $count profile(s) repaired and updated."
  fi
}

update_cli() {
  local script_url="https://raw.githubusercontent.com/rakibkhanofficial/multigravity-duo/main/multigravity"
  local target
  target="$(script_path)"

  if [ -z "$target" ]; then
    abort "could not determine script path for update"
  fi

  print_info "Updating multigravity from $script_url ..."
  if curl -fsSL "$script_url" -o "$target.tmp"; then
    mv "$target.tmp" "$target"
    chmod +x "$target"
    print_info "Successfully updated Multigravity Duo!"
  else
    rm -f "$target.tmp"
    abort "failed to download update"
  fi
}

uninstall_cli() {
  local confirm
  read -r -p "Are you sure you want to uninstall Multigravity Duo? [y/N] " confirm
  if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    print_info "Aborted."
    return 0
  fi

  case "$(platform)" in
    darwin)
      if ls "$HOME/Applications"/Multigravity*.app 1>/dev/null 2>&1; then
        print_info "Removing macOS launcher shortcuts..."
        rm -rf "$HOME/Applications"/Multigravity*.app
      fi
      ;;
    linux)
      if ls "$HOME/.local/share/applications"/multigravity-*.desktop 1>/dev/null 2>&1; then
        print_info "Removing Linux desktop shortcuts..."
        rm -f "$HOME/.local/share/applications"/multigravity-*.desktop
      fi
      if [ -d "$HOME/.local/share/multigravity" ]; then
        rm -rf "$HOME/.local/share/multigravity"
      fi
      ;;
  esac

  if [ -d "$BASE" ]; then
    read -r -p "Do you also want to permanently delete all profile data in $BASE? [y/N] " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
      rm -rf "$BASE"
      print_info "Deleted profile directory: $BASE"
    else
      print_info "Kept profile directory: $BASE"
    fi
  fi

  local target
  target="$(script_path)"
  if [ -n "$target" ] && [ -f "$target" ]; then
    print_info "Removing multigravity CLI binary ($target)..."
    if [ -w "$target" ]; then
      rm -f "$target"
    else
      sudo rm -f "$target"
    fi
    local icon_target
    icon_target="$(dirname "$target")/icon.icns"
    if [ -f "$icon_target" ]; then
      if [ -w "$icon_target" ]; then
        rm -f "$icon_target"
      else
        sudo rm -f "$icon_target" 2>/dev/null || true
      fi
    fi
  fi

  print_info "✓ Multigravity Duo uninstalled successfully!"
}

