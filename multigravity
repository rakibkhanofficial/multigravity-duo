generate_completion() {
  local shell_type=$1
  case "$shell_type" in
    zsh)
      cat <<'EOF'
#compdef multigravity
_multigravity() {
    local -a commands
    commands=(
        'new:Create a new profile'
        'ide:Launch Antigravity IDE for a profile'
        'chat:Launch Antigravity Chat companion for a profile'
        'all:Launch both IDE and Chat simultaneously'
        'list:List existing profiles'
        'status:Show profile status (running, type, last used)'
        'rename:Rename a profile'
        'delete:Delete a profile'
        'clone:Clone an existing profile'
        'template:Manage profile templates (save, list, delete)'
        'export:Export a profile to tar.gz'
        'import:Import a profile from tar.gz'
        'update:Update Multigravity Duo'
        'uninstall:Uninstall Multigravity Duo'
        'doctor:Run system diagnosis'
        'stats:Show profile storage usage'
        'completion:Setup shell completion'
        'help:Show help'
    )
    local curcontext="$curcontext" state line
    _arguments -C '1: :->command' '*: :->args'
    case $state in
        command)
            _describe -t commands 'multigravity command' commands
            local -a profiles
            profiles=($(multigravity list --raw 2>/dev/null))
            (( ${#profiles} > 0 )) && _describe -t profiles 'profile' profiles
            ;;
        args)
            case $line[1] in
                rename|delete|clone|help|ide|chat|all)
                    local -a profiles
                    profiles=($(multigravity list --raw 2>/dev/null))
                    (( ${#profiles} > 0 )) && _describe -t profiles 'profile' profiles
                    ;;
            esac
            ;;
    esac
}
_multigravity "$@"
EOF
      ;;
    bash)
      cat <<'EOF'
_multigravity_completions() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    opts="new ide chat all list status rename delete clone template export import repair update uninstall doctor stats completion help --ide --chat --all"

    if [[ ${COMP_CWORD} -eq 1 ]] ; then
        local profiles=$(multigravity list --raw 2>/dev/null)
        COMPREPLY=( $(compgen -W "${opts} ${profiles}" -- ${cur}) )
        return 0
    fi

    case "${prev}" in
        delete|rename|clone|ide|chat|all)
            local profiles=$(multigravity list --raw 2>/dev/null)
            COMPREPLY=( $(compgen -W "${profiles}" -- ${cur}) )
            return 0
            ;;
    esac
}
complete -F _multigravity_completions multigravity
EOF
      ;;
  esac
}

# --- Templates ---
template_save() {
  local profile=$1
  local tpl_name=$2

  validate_name "$profile"
  validate_name "$tpl_name"

  local profile_path
  profile_path="$(profile_dir "$profile")"
  if [ ! -d "$profile_path" ]; then
    abort "profile '$profile' does not exist"
  fi

  local tpl_dir
  tpl_dir="$(templates_dir)"
  local tpl_path="$tpl_dir/$tpl_name"

  if [ -d "$tpl_path" ]; then
    abort "template '$tpl_name' already exists"
  fi

  mkdir -p "$tpl_dir"
  print_info "Saving profile '$profile' as template '$tpl_name'..."
  cp -R "$profile_path" "$tpl_path"
  rm -f "$tpl_path/.auth-only"

  print_info "Template '$tpl_name' saved"
}

template_list() {
  local tpl_dir
  tpl_dir="$(templates_dir)"

  echo "Available templates:"
  if [ ! -d "$tpl_dir" ]; then
    echo "  (none)"
    return 0
  fi

  local found=false
  for dir in "$tpl_dir"/*; do
    [ -d "$dir" ] || continue
    found=true
    local name size
    name=$(basename "$dir")
    size=$(du -sh "$dir" 2>/dev/null | cut -f1)
    echo "  $name  ($size)"
  done

  if [ "$found" = false ]; then
    echo "  (none)"
  fi
}

template_delete() {
  local tpl_name=$1
  validate_name "$tpl_name"

  local tpl_path
  tpl_path="$(templates_dir)/$tpl_name"

  if [ ! -d "$tpl_path" ]; then
    abort "template '$tpl_name' does not exist"
  fi

  rm -rf "$tpl_path"
  print_info "Deleted template '$tpl_name'"
}

# --- Status ---
status_profiles() {
  if [ ! -d "$BASE" ]; then
    print_info "No profiles found."
    return 0
  fi

  printf "%-16s %-12s %-12s %-10s %-18s %s\n" "PROFILE" "IDE" "CHAT" "TYPE" "LAST USED" "SIZE"
  printf "%-16s %-12s %-12s %-10s %-18s %s\n" "-------" "---" "----" "----" "---------" "----"

  for dir in "$BASE"/*; do
    [ -d "$dir" ] || continue
    local name
    name=$(basename "$dir")
    [ "$name" = ".templates" ] && continue

    local ide_status="stopped"
    local chat_status="stopped"
    local ide_data chat_data
    ide_data="$(ide_user_data_dir "$dir")"
    chat_data="$(chat_user_data_dir "$dir")"

    if ps -eo args 2>/dev/null | grep -v grep | grep -qF "$ide_data" 2>/dev/null; then
      ide_status="running"
    fi

    if ps -eo args 2>/dev/null | grep -v grep | grep -qF "$chat_data" 2>/dev/null; then
      chat_status="running"
    fi

    local ptype="full"
    if [ -f "$dir/.auth-only" ]; then
      ptype="auth-only"
    fi

    local last_used="unknown"
    case "$(platform)" in
      darwin)
        last_used=$(stat -f "%Sm" -t "%Y-%m-%d %H:%M" "$dir" 2>/dev/null || echo "unknown")
        ;;
      linux)
        last_used=$(stat -c "%y" "$dir" 2>/dev/null | cut -d'.' -f1 || echo "unknown")
        ;;
    esac

    local size
    size=$(du -sh "$dir" 2>/dev/null | cut -f1)

    local ide_field chat_field
    if [ "$ide_status" = "running" ]; then
      ide_field=$(printf "\033[32m%-10s\033[0m" "$ide_status")
    else
      ide_field=$(printf "%-10s" "$ide_status")
    fi

    if [ "$chat_status" = "running" ]; then
      chat_field=$(printf "\033[32m%-10s\033[0m" "$chat_status")
    else
      chat_field=$(printf "%-10s" "$chat_status")
    fi

    printf "%-16s %b  %b  %-10s %-18s %s\n" "$name" "$ide_field" "$chat_field" "$ptype" "$last_used" "$size"
  done
}

# --- Export / Import ---
export_profile() {
  local profile=$1
  local output_path=${2-}

  validate_name "$profile"

  local profile_path
  profile_path="$(profile_dir "$profile")"
  if [ ! -d "$profile_path" ]; then
    abort "profile '$profile' does not exist"
  fi

  if [ -z "$output_path" ]; then
    output_path="./${profile}.tar.gz"
  fi

  print_info "Exporting profile '$profile'..."
  tar -czf "$output_path" -C "$BASE" "$profile"
  print_info "Exported to $output_path"
}

import_profile() {
  local archive_path=$1
  local profile=${2-}

  if [ -z "$archive_path" ]; then
    abort "usage: multigravity import <archive> [profile-name]"
  fi

  if [ ! -f "$archive_path" ]; then
    abort "file '$archive_path' not found"
  fi

  if [ -z "$profile" ]; then
    profile=$(tar -tzf "$archive_path" 2>/dev/null | head -1 | cut -d'/' -f1)
    if [ -z "$profile" ]; then
      abort "could not determine profile name from archive. Specify a name: multigravity import <path> <name>"
    fi
  fi

  validate_name "$profile"

  local profile_path
  profile_path="$(profile_dir "$profile")"
  if [ -d "$profile_path" ]; then
    abort "profile '$profile' already exists"
  fi

  mkdir -p "$BASE"
  print_info "Importing profile as '$profile'..."

  local top_dir
  top_dir=$(tar -tzf "$archive_path" 2>/dev/null | head -1 | cut -d'/' -f1)

  if [ "$top_dir" = "$profile" ]; then
    tar -xzf "$archive_path" -C "$BASE"
  elif [ -n "$top_dir" ]; then
    tar -xzf "$archive_path" -C "$BASE"
    if [ "$top_dir" != "$profile" ] && [ -d "$BASE/$top_dir" ]; then
      mv "$BASE/$top_dir" "$profile_path"
    fi
  else
    mkdir -p "$profile_path"
    tar -xzf "$archive_path" -C "$profile_path"
  fi

  create_shortcuts "$profile"
  print_info "Imported profile '$profile'"
}

usage() {
  cat <<EOF
Multigravity Duo — Run multiple Antigravity IDE & Antigravity Companion profiles simultaneously.

Usage: multigravity <command|profile> [options] [args...]

Launching:
  multigravity <profile> [args...]       Launch Antigravity IDE (default)
  multigravity <profile> --chat [args..] Launch Antigravity Chat (Companion)
  multigravity <profile> --all [args...] Launch BOTH Antigravity IDE and Chat
  multigravity ide <profile> [args...]   Shortcut: launch Antigravity IDE
  multigravity chat <profile> [args...]  Shortcut: launch Antigravity Chat
  multigravity all <profile> [args...]   Shortcut: launch both simultaneously

Profile Management:
  multigravity new <name> [options]      Create a profile & desktop shortcuts
      --auth-only                        Share extensions & settings, isolate logins
      --from <template>                  Create from a saved template
  multigravity list                      List existing profiles
  multigravity status                    Show IDE & Chat running status, type, size
  multigravity rename <old> <new>        Rename a profile (updates shortcuts)
  multigravity delete <name>             Delete a profile and its data
  multigravity clone <src> <dest>        Clone an existing profile

Templates & Portability:
  multigravity template save <profile> <name>   Save profile as template
  multigravity template list                    List available templates
  multigravity template delete <name>           Delete a template
  multigravity export <name> [path]             Export profile to tar.gz
  multigravity import <archive> [name]          Import profile from tar.gz

Diagnostics & Setup:
  multigravity doctor                    Verify Antigravity IDE & Chat environment
  multigravity repair [name]             Repair/sync global resources & shortcuts
  multigravity stats                     Storage and extension counts per profile
  multigravity completion [bash|zsh]     Generate shell autocomplete script
  multigravity update                    Update Multigravity Duo to latest version
  multigravity uninstall                 Uninstall Multigravity Duo and components
  multigravity help                      Show this help

Environment Variables:
  MULTIGRAVITY_IDE_APP                   Override Antigravity IDE app path
  MULTIGRAVITY_CHAT_APP                  Override Antigravity Chat app path
  MULTIGRAVITY_HOME                      Override profile storage (~/AntigravityProfiles)
EOF
}

case "$cmd" in
  new)
    shift
    new_profile "$@"
    ;;
  ide)
    shift
    [ $# -gt 0 ] || abort "usage: multigravity ide <profile> [args...]"
    launch_profile "$1" --ide "${@:2}"
    ;;
  chat)
    shift
    [ $# -gt 0 ] || abort "usage: multigravity chat <profile> [args...]"
    launch_profile "$1" --chat "${@:2}"
    ;;
  all)
    shift
    [ $# -gt 0 ] || abort "usage: multigravity all <profile> [args...]"
    launch_profile "$1" --all "${@:2}"
    ;;
  list)
    list_profiles "${2-}"
    ;;
  rename)
    rename_profile "${2-}" "${3-}"
    ;;
  delete)
    delete_profile "${2-}"
    ;;
  clone)
    clone_profile "${2-}" "${3-}"
    ;;
  template)
    case "${2-}" in
      save)
        template_save "${3-}" "${4-}"
        ;;
      list)
        template_list
        ;;
      delete)
        template_delete "${3-}"
        ;;
      *)
        abort "usage: multigravity template <save|list|delete>"
        ;;
    esac
    ;;
  status)
    status_profiles
    ;;
  export)
    export_profile "${2-}" "${3-}"
    ;;
  import)
    import_profile "${2-}" "${3-}"
    ;;
  repair)
    shift
    repair_profile "${1-}"
    ;;
  update)
    update_cli
    ;;
  uninstall)
    uninstall_cli
    ;;
  doctor)
    doctor_cli
    ;;
  stats)
    profile_stats
    ;;
  completion)
    if [ -n "${2-}" ]; then
      generate_completion "$2"
    else
      help_completion
    fi
    ;;
  help | --help | -h)
    usage
    ;;
  "")
    usage
    exit 1
    ;;
  *)
    launch_profile "$cmd" "${@:2}"
    ;;
esac
