#!/usr/bin/env bash
set -euo pipefail

shopt -s nullglob 2>/dev/null || true

REAL_HOME="${REAL_USER_HOME:-${HOME}}"
BASE="${MULTIGRAVITY_HOME:-$REAL_HOME/AntigravityProfiles}"
cmd="${1-}"

abort() {
  echo "Error: $1" >&2
  exit 1
}

print_info() {
  echo "$1"
}

platform() {
  local raw
  raw="${MULTIGRAVITY_PLATFORM-}"
  if [ -z "$raw" ]; then
    raw="$(uname -s)"
  fi

  raw="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"

  case "$raw" in
    darwin | macos | mac | osx)
      printf '%s\n' "darwin"
      ;;
    linux)
      printf '%s\n' "linux"
      ;;
    *)
      abort "unsupported platform '$raw'. Multigravity Duo supports macOS and Linux."
      ;;
  esac
}

profile_dir() {
  printf '%s/%s\n' "$BASE" "$1"
}

# --- IDE Paths ---
ide_user_data_dir() {
  local profile_path=$1
  case "$(platform)" in
    darwin)
      printf '%s/Library/Application Support/Antigravity IDE\n' "$profile_path"
      ;;
    linux)
      printf '%s/.config/Antigravity IDE\n' "$profile_path"
      ;;
  esac
}

ide_extensions_dir() {
  local profile_path=$1
  printf '%s/.antigravity-ide/extensions\n' "$profile_path"
}

default_ide_user_data_dir() {
  case "$(platform)" in
    darwin)
      printf '%s/Library/Application Support/Antigravity IDE\n' "$REAL_HOME"
      ;;
    linux)
      printf '%s/.config/Antigravity IDE\n' "$REAL_HOME"
      ;;
  esac
}

default_ide_extensions_dir() {
  printf '%s/.antigravity-ide/extensions\n' "$REAL_HOME"
}

# --- Chat (Antigravity Companion) Paths ---
chat_user_data_dir() {
  local profile_path=$1
  case "$(platform)" in
    darwin)
      printf '%s/Library/Application Support/Antigravity\n' "$profile_path"
      ;;
    linux)
      printf '%s/.config/Antigravity\n' "$profile_path"
      ;;
  esac
}

chat_extensions_dir() {
  local profile_path=$1
  printf '%s/.antigravity/extensions\n' "$profile_path"
}

default_chat_user_data_dir() {
  case "$(platform)" in
    darwin)
      printf '%s/Library/Application Support/Antigravity\n' "$REAL_HOME"
      ;;
    linux)
      printf '%s/.config/Antigravity\n' "$REAL_HOME"
      ;;
  esac
}

default_chat_extensions_dir() {
  printf '%s/.antigravity/extensions\n' "$REAL_HOME"
}

templates_dir() {
  printf '%s/.templates\n' "$BASE"
}

is_auth_only() {
  [ -f "$(profile_dir "$1")/.auth-only" ]
}

linux_launcher_dir() {
  printf '%s/.local/share/multigravity/launchers\n' "$REAL_HOME"
}

linux_launcher_path() {
  local target_app=${2:-ide}
  if [ "$target_app" = "ide" ]; then
    printf '%s/%s-ide.sh\n' "$(linux_launcher_dir)" "$1"
  elif [ "$target_app" = "chat" ]; then
    printf '%s/%s-chat.sh\n' "$(linux_launcher_dir)" "$1"
  else
    printf '%s/%s-duo.sh\n' "$(linux_launcher_dir)" "$1"
  fi
}

linux_desktop_path() {
  local target_app=${2:-ide}
  if [ "$target_app" = "ide" ]; then
    printf '%s/.local/share/applications/multigravity-%s-ide.desktop\n' "$REAL_HOME" "$1"
  elif [ "$target_app" = "chat" ]; then
    printf '%s/.local/share/applications/multigravity-%s-chat.desktop\n' "$REAL_HOME" "$1"
  else
    printf '%s/.local/share/applications/multigravity-%s-duo.desktop\n' "$REAL_HOME" "$1"
  fi
}

mac_shortcut_path() {
  local profile=$1
  local target_app=${2:-ide}
  if [ "$target_app" = "ide" ]; then
    printf '%s/Applications/Multigravity %s IDE.app\n' "$REAL_HOME" "$profile"
  elif [ "$target_app" = "chat" ]; then
    printf '%s/Applications/Multigravity %s.app\n' "$REAL_HOME" "$profile"
  else
    printf '%s/Applications/Multigravity %s Duo.app\n' "$REAL_HOME" "$profile"
  fi
}

validate_name() {
  local name=$1

  if [[ -z "$name" ]]; then
    abort "profile name required"
  fi

  if ! [[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]*$ ]]; then
    abort "profile name must start with alphanumeric and contain only letters, numbers, or hyphens"
  fi
}

command_or_path() {
  local candidate=$1

  if [ -z "$candidate" ]; then
    return 1
  fi

  if [ -d "$candidate" ] || [ -x "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  if command -v "$candidate" >/dev/null 2>&1; then
    command -v "$candidate"
    return 0
  fi

  return 1
}

# --- Find Antigravity IDE ---
find_ide_app() {
  local override candidate

  override="${MULTIGRAVITY_IDE_APP-}"
  if [ -n "$override" ] && command_or_path "$override" >/dev/null 2>&1; then
    command_or_path "$override"
    return 0
  fi

  case "$(platform)" in
    darwin)
      for candidate in \
        "/Applications/Antigravity IDE.app" \
        "$REAL_HOME/Applications/Antigravity IDE.app"
      do
        if [ -d "$candidate" ]; then
          printf '%s\n' "$candidate"
          return 0
        fi
      done
      ;;
    linux)
      for candidate in \
        "antigravity-ide" \
        "/usr/share/antigravity-ide/antigravity-ide" \
        "/usr/bin/antigravity-ide" \
        "/usr/local/bin/antigravity-ide" \
        "$REAL_HOME/.local/bin/antigravity-ide" \
        "$REAL_HOME/Applications/Antigravity-IDE.AppImage"
      do
        if command_or_path "$candidate" >/dev/null 2>&1; then
          command_or_path "$candidate"
          return 0
        fi
      done
      ;;
  esac

  return 1
}

# --- Find Antigravity Chat (Companion) ---
find_chat_app() {
  local override candidate

  override="${MULTIGRAVITY_CHAT_APP:-${MULTIGRAVITY_APP-}}"
  if [ -n "$override" ] && command_or_path "$override" >/dev/null 2>&1; then
    command_or_path "$override"
    return 0
  fi

  case "$(platform)" in
    darwin)
      for candidate in \
        "/Applications/Antigravity.app" \
        "$REAL_HOME/Applications/Antigravity.app"
      do
        if [ -d "$candidate" ]; then
          printf '%s\n' "$candidate"
          return 0
        fi
      done
      ;;
    linux)
      for candidate in \
        "antigravity" \
        "/usr/share/antigravity/antigravity" \
        "/usr/bin/antigravity" \
        "/usr/local/bin/antigravity" \
        "$REAL_HOME/.local/bin/antigravity" \
        "$REAL_HOME/Applications/Antigravity.AppImage"
      do
        if command_or_path "$candidate" >/dev/null 2>&1; then
          command_or_path "$candidate"
          return 0
        fi
      done
      ;;
  esac

  return 1
}

require_ide_app() {
  local app
  if ! app="$(find_ide_app)"; then
    case "$(platform)" in
      darwin)
        abort "Antigravity IDE.app was not found. Install Antigravity IDE or set MULTIGRAVITY_IDE_APP."
        ;;
      linux)
        abort "Antigravity IDE was not found. Install Antigravity IDE or set MULTIGRAVITY_IDE_APP."
        ;;
    esac
  fi
  printf '%s\n' "$app"
}

require_chat_app() {
  local app
  if ! app="$(find_chat_app)"; then
    case "$(platform)" in
      darwin)
        abort "Antigravity.app (Chat) was not found. Install Antigravity or set MULTIGRAVITY_CHAT_APP."
        ;;
      linux)
        abort "Antigravity was not found. Install Antigravity or set MULTIGRAVITY_CHAT_APP."
        ;;
    esac
  fi
  printf '%s\n' "$app"
}

setup_ssh_symlink() {
  local profile_path=$1
  local real_ssh="$REAL_HOME/.ssh"

  if [ ! -d "$real_ssh" ]; then
    mkdir -p "$real_ssh"
    chmod 700 "$real_ssh"
  fi

  if [ -L "$profile_path/.ssh" ]; then
    local current_target
    current_target="$(readlink "$profile_path/.ssh" 2>/dev/null || true)"
    if [ "$current_target" != "$real_ssh" ]; then
      rm -f "$profile_path/.ssh"
      ln -s "$real_ssh" "$profile_path/.ssh"
    fi
  elif [ -d "$profile_path/.ssh" ]; then
    # Merge any files from profile .ssh into real_ssh if not already present
    for f in "$profile_path/.ssh"/*; do
      [ -e "$f" ] || continue
      local fname
      fname="$(basename "$f")"
      if [ ! -e "$real_ssh/$fname" ]; then
        cp -p "$f" "$real_ssh/$fname" 2>/dev/null || true
      fi
    done
    rm -rf "$profile_path/.ssh"
    ln -s "$real_ssh" "$profile_path/.ssh"
  else
    rm -f "$profile_path/.ssh" 2>/dev/null || true
    ln -s "$real_ssh" "$profile_path/.ssh"
  fi
}

setup_git_symlink() {
  local profile_path=$1
  if [ -f "$REAL_HOME/.gitconfig" ] && [ ! -e "$profile_path/.gitconfig" ]; then
    ln -s "$REAL_HOME/.gitconfig" "$profile_path/.gitconfig"
  fi
}

setup_gemini_skills_and_plugins() {
  local profile_path=$1
  local real_gemini="$REAL_HOME/.gemini"

  [ -d "$real_gemini" ] || return 0

  mkdir -p "$profile_path/.gemini/config"
  mkdir -p "$profile_path/.gemini/antigravity-ide"

  # 1. Share installed plugins and skills
  if [ -d "$real_gemini/config/plugins" ]; then
    if [ ! -e "$profile_path/.gemini/config/plugins" ]; then
      ln -s "$real_gemini/config/plugins" "$profile_path/.gemini/config/plugins"
    elif [ -d "$profile_path/.gemini/config/plugins" ] && [ ! -L "$profile_path/.gemini/config/plugins" ]; then
      for p in "$real_gemini/config/plugins"/*; do
        [ -e "$p" ] || continue
        local pname
        pname="$(basename "$p")"
        if [ ! -e "$profile_path/.gemini/config/plugins/$pname" ]; then
          ln -s "$p" "$profile_path/.gemini/config/plugins/$pname"
        fi
      done
    fi
  fi

  # 2. Share MCP config if missing or empty
  if [ -f "$real_gemini/config/mcp_config.json" ]; then
    if [ ! -e "$profile_path/.gemini/config/mcp_config.json" ] || [ ! -s "$profile_path/.gemini/config/mcp_config.json" ]; then
      rm -f "$profile_path/.gemini/config/mcp_config.json" 2>/dev/null || true
      ln -s "$real_gemini/config/mcp_config.json" "$profile_path/.gemini/config/mcp_config.json"
    fi
  fi

  # 3. Share builtin skills & MCP tools
  if [ -d "$real_gemini/antigravity-ide/builtin" ] && [ ! -e "$profile_path/.gemini/antigravity-ide/builtin" ]; then
    ln -s "$real_gemini/antigravity-ide/builtin" "$profile_path/.gemini/antigravity-ide/builtin"
  fi
  if [ -d "$real_gemini/antigravity-ide/mcp" ] && [ ! -e "$profile_path/.gemini/antigravity-ide/mcp" ]; then
    ln -s "$real_gemini/antigravity-ide/mcp" "$profile_path/.gemini/antigravity-ide/mcp"
  fi
  if [ -d "$real_gemini/antigravity-ide/knowledge" ] && [ ! -e "$profile_path/.gemini/antigravity-ide/knowledge" ]; then
    ln -s "$real_gemini/antigravity-ide/knowledge" "$profile_path/.gemini/antigravity-ide/knowledge"
  fi
}

setup_global_folders_symlink() {
  local profile_path=$1

  # Direct link to original home folder
  if [ ! -e "$profile_path/home" ] && [ -d "$REAL_HOME" ]; then
    ln -s "$REAL_HOME" "$profile_path/home"
  fi

  # Standard user workspace and content folders
  for folder in Desktop Documents Downloads Pictures Movies Music Public Projects Development workspace code; do
    if [ -d "$REAL_HOME/$folder" ] && [ ! -e "$profile_path/$folder" ]; then
      ln -s "$REAL_HOME/$folder" "$profile_path/$folder"
    fi
  done
}

setup_shell_and_tool_configs() {
  local profile_path=$1

  # Shell dotfiles for seamless terminal and environment
  for dotfile in .zshrc .zprofile .zshenv .bashrc .bash_profile .profile .npmrc .wakatime.cfg .claude.json; do
    if [ -f "$REAL_HOME/$dotfile" ] && [ ! -e "$profile_path/$dotfile" ]; then
      ln -s "$REAL_HOME/$dotfile" "$profile_path/$dotfile"
    fi
  done

  # Global tool and environment directories
  for tooldir in .nvm .gnupg .aws .docker .orbstack; do
    if [ -d "$REAL_HOME/$tooldir" ] && [ ! -e "$profile_path/$tooldir" ]; then
      ln -s "$REAL_HOME/$tooldir" "$profile_path/$tooldir"
    fi
  done

  # Global .config sharing (excluding Antigravity profile dirs)
  if [ -d "$REAL_HOME/.config" ]; then
    mkdir -p "$profile_path/.config"
    for citem in "$REAL_HOME/.config"/*; do
      [ -e "$citem" ] || continue
      local cname
      cname="$(basename "$citem")"
      case "$cname" in
        "Antigravity"* | "antigravity"*)
          ;;
        *)
          if [ ! -e "$profile_path/.config/$cname" ]; then
            ln -s "$citem" "$profile_path/.config/$cname"
          fi
          ;;
      esac
    done
  fi
}

setup_profile_shared_resources() {
  local profile_path=$1

  # 1. SSH configuration and keys for Remote SSH / VM access
  setup_ssh_symlink "$profile_path"

  # 2. Git global config for developer identity & commits
  setup_git_symlink "$profile_path"

  # 3. Gemini skills, plugins, MCP servers, and builtin tools
  setup_gemini_skills_and_plugins "$profile_path"

  # 4. Global developer folders (Desktop, Documents, Downloads, etc.)
  setup_global_folders_symlink "$profile_path"

  # 5. Shell and developer tool configurations (.zshrc, .config, .nvm, etc.)
  setup_shell_and_tool_configs "$profile_path"
}

create_profile_layout() {
  local profile_path=$1

  mkdir -p "$profile_path"
  mkdir -p "$(ide_extensions_dir "$profile_path")"
  mkdir -p "$(chat_extensions_dir "$profile_path")"
  mkdir -p "$profile_path/.gemini"

  case "$(platform)" in
    darwin)
      mkdir -p "$profile_path/Library/Application Support/Antigravity IDE"
      mkdir -p "$profile_path/Library/Application Support/Antigravity"

      if [ ! -e "$profile_path/Library/Keychains" ] && [ -d "$REAL_HOME/Library/Keychains" ]; then
        ln -s "$REAL_HOME/Library/Keychains" "$profile_path/Library/Keychains"
      fi
      ;;
    linux)
      mkdir -p \
        "$profile_path/.config/Antigravity IDE" \
        "$profile_path/.config/Antigravity" \
        "$profile_path/.cache" \
        "$profile_path/.local/share" \
        "$profile_path/.local/state"
      ;;
  esac

  setup_profile_shared_resources "$profile_path"
}

create_auth_only_layout() {
  local profile_path=$1
  local def_ide_data def_ide_ext def_chat_data def_chat_ext

  def_ide_data="$(default_ide_user_data_dir)"
  def_ide_ext="$(default_ide_extensions_dir)"
  def_chat_data="$(default_chat_user_data_dir)"
  def_chat_ext="$(default_chat_extensions_dir)"

  mkdir -p "$profile_path"
  touch "$profile_path/.auth-only"
  mkdir -p "$profile_path/.gemini"

  # 1. Antigravity IDE Setup
  local ide_data
  ide_data="$(ide_user_data_dir "$profile_path")"
  mkdir -p "$ide_data/User"
  if [ -d "$def_ide_data/User" ]; then
    for item in settings.json keybindings.json snippets; do
      local src="$def_ide_data/User/$item"
      local dest="$ide_data/User/$item"
      if [ -e "$src" ] && [ ! -e "$dest" ]; then
        ln -s "$src" "$dest"
      fi
    done
  fi

  local ide_ext
  ide_ext="$(ide_extensions_dir "$profile_path")"
  mkdir -p "$(dirname "$ide_ext")"
  if [ -d "$def_ide_ext" ]; then
    rm -rf "$ide_ext" 2>/dev/null || true
    ln -s "$def_ide_ext" "$ide_ext"
  else
    mkdir -p "$ide_ext"
  fi

  # 2. Antigravity Chat Setup
  local chat_data
  chat_data="$(chat_user_data_dir "$profile_path")"
  mkdir -p "$chat_data/User"
  if [ -d "$def_chat_data/User" ]; then
    for item in settings.json keybindings.json snippets; do
      local src="$def_chat_data/User/$item"
      local dest="$chat_data/User/$item"
      if [ -e "$src" ] && [ ! -e "$dest" ]; then
        ln -s "$src" "$dest"
      fi
    done
  fi

  local chat_ext
  chat_ext="$(chat_extensions_dir "$profile_path")"
  mkdir -p "$(dirname "$chat_ext")"
  if [ -d "$def_chat_ext" ]; then
    rm -rf "$chat_ext" 2>/dev/null || true
    ln -s "$def_chat_ext" "$chat_ext"
  else
    mkdir -p "$chat_ext"
  fi

  # OS-specific dirs & keychains
  case "$(platform)" in
    darwin)
      mkdir -p "$profile_path/Library/Application Support"
      if [ ! -e "$profile_path/Library/Keychains" ] && [ -d "$REAL_HOME/Library/Keychains" ]; then
        ln -s "$REAL_HOME/Library/Keychains" "$profile_path/Library/Keychains"
      fi
      ;;
    linux)
      mkdir -p \
        "$profile_path/.cache" \
        "$profile_path/.local/share" \
        "$profile_path/.local/state"
      ;;
  esac

  setup_profile_shared_resources "$profile_path"
}

script_path() {
  local installed dir

  installed="$(command -v multigravity 2>/dev/null || true)"
  if [ -n "$installed" ]; then
    printf '%s\n' "$installed"
    return 0
  fi

  dir="$(cd "$(dirname "$0")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$0")"
}

shell_quote() {
  printf '%q' "$1"
}

desktop_quote() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//\$/\\$}
  value=${value//\`/\\\`}
  printf '"%s"' "$value"
}

create_shortcut_darwin_single() {
  local profile=$1
  local app_type=$2 # ide, chat, duo
  local app_dir
  local run_script
  local launcher
  local icon_src
  local app_title
  local bundle_id
  local launch_flag

  launcher="$(script_path)"
  icon_src="$(dirname "$launcher")/icon.icns"
  if [ ! -f "$icon_src" ]; then
    icon_src="$(cd "$(dirname "$0")" && pwd)/icon.icns"
  fi
  if [ ! -f "$icon_src" ]; then
    icon_src="$REAL_HOME/.local/bin/icon.icns"
  fi

  local profile_path data_dir ext_dir
  profile_path="$(profile_dir "$profile")"

  if [ "$app_type" = "ide" ]; then
    app_title="Multigravity $profile IDE"
    bundle_id="com.multigravity.profile.$profile.ide"
    launch_flag="--ide"
    data_dir="$(ide_user_data_dir "$profile_path")"
    ext_dir="$(ide_extensions_dir "$profile_path")"
  elif [ "$app_type" = "chat" ]; then
    app_title="Multigravity $profile"
    bundle_id="com.multigravity.profile.$profile.chat"
    launch_flag="--chat"
    data_dir="$(chat_user_data_dir "$profile_path")"
    ext_dir="$(chat_extensions_dir "$profile_path")"
  else
    app_title="Multigravity $profile Duo"
    bundle_id="com.multigravity.profile.$profile.duo"
    launch_flag="--all"
  fi

  app_dir="$(mac_shortcut_path "$profile" "$app_type")"

  rm -rf "$app_dir"
  mkdir -p "$app_dir/Contents/MacOS"
  mkdir -p "$app_dir/Contents/Resources"
  run_script="$app_dir/Contents/MacOS/run"

  cat <<EOF > "$run_script"
#!/usr/bin/env bash
export MULTIGRAVITY_HOME=$(shell_quote "$BASE")
export SSH_AUTH_SOCK="\${SSH_AUTH_SOCK:-}"
export SSH_AGENT_PID="\${SSH_AGENT_PID:-}"
exec $(shell_quote "$launcher") $(shell_quote "$profile") "$launch_flag" "\$@"
EOF

  chmod +x "$run_script"

  if [ -f "$icon_src" ]; then
    cp "$icon_src" "$app_dir/Contents/Resources/icon.icns" 2>/dev/null || true
  fi

  cat <<EOF > "$app_dir/Contents/Info.plist"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
"http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>run</string>
  <key>CFBundleIconFile</key>
  <string>icon</string>
  <key>CFBundleIdentifier</key>
  <string>$bundle_id</string>
  <key>CFBundleName</key>
  <string>$app_title</string>
  <key>CFBundleDisplayName</key>
  <string>$app_title</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>LSUIElement</key>
  <string>0</string>
</dict>
</plist>
EOF

  codesign --force --sign - "$app_dir" 2>/dev/null || true
  xattr -cr "$app_dir" 2>/dev/null || true
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app_dir" 2>/dev/null || true

  print_info "Shortcut created: $app_dir"
}

create_shortcut_linux_single() {
  local profile=$1
  local app_type=$2 # ide, chat, duo
  local launcher_root
  local launcher_path
  local desktop_path
  local launcher
  local launch_flag
  local app_title
  local icon_target

  launcher_root="$(linux_launcher_dir)"
  launcher_path="$(linux_launcher_path "$profile" "$app_type")"
  desktop_path="$(linux_desktop_path "$profile" "$app_type")"
  launcher="$(script_path)"
  icon_target="$(dirname "$launcher")/icon.png"
  if [ ! -f "$icon_target" ]; then
    icon_target="$HOME/.local/share/multigravity/icon.png"
  fi
  if [ ! -f "$icon_target" ]; then
    icon_target="antigravity"
  fi

  if [ "$app_type" = "ide" ]; then
    app_title="Multigravity $profile (IDE)"
    launch_flag="--ide"
  elif [ "$app_type" = "chat" ]; then
    app_title="Multigravity $profile (Chat)"
    launch_flag="--chat"
  else
    app_title="Multigravity $profile (Duo)"
    launch_flag="--all"
  fi

  mkdir -p "$launcher_root"
  mkdir -p "$(dirname "$desktop_path")"

  cat <<EOF > "$launcher_path"
#!/usr/bin/env sh
export MULTIGRAVITY_HOME=$(shell_quote "$BASE")
exec $(shell_quote "$launcher") $(shell_quote "$profile") "$launch_flag" "\$@"
EOF

  chmod +x "$launcher_path"

  cat <<EOF > "$desktop_path"
[Desktop Entry]
Version=1.0
Type=Application
Name=$app_title
Comment=Launch $app_title Antigravity profile
Exec=$(desktop_quote "$launcher_path") %F
Icon=$icon_target
Terminal=false
StartupNotify=false
StartupWMClass=multigravity-$profile-$app_type
Categories=Development;IDE;Chat;
EOF

  print_info "Shortcut created: $desktop_path"
}

create_shortcuts() {
  local profile=$1
  case "$(platform)" in
    darwin)
      create_shortcut_darwin_single "$profile" "ide"
      create_shortcut_darwin_single "$profile" "chat"
      create_shortcut_darwin_single "$profile" "duo"
      ;;
    linux)
      create_shortcut_linux_single "$profile" "ide"
      create_shortcut_linux_single "$profile" "chat"
      create_shortcut_linux_single "$profile" "duo"
      ;;
  esac
}

remove_shortcuts() {
  local profile=$1
  case "$(platform)" in
    darwin)
      for app_type in ide chat duo; do
        local target
        target="$(mac_shortcut_path "$profile" "$app_type")"
        if [ -d "$target" ]; then
          rm -rf "$target"
          print_info "Removed shortcut: $target"
        fi
      done
      ;;
    linux)
      for app_type in ide chat duo; do
        local target
        target="$(linux_launcher_path "$profile" "$app_type")"
        if [ -f "$target" ]; then
          rm -f "$target"
          print_info "Removed launcher: $target"
        fi
        target="$(linux_desktop_path "$profile" "$app_type")"
        if [ -f "$target" ]; then
          rm -f "$target"
          print_info "Removed shortcut: $target"
        fi
      done
      ;;
  esac
}

